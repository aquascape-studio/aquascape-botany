{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aquascape-studio/aquascape-botany/blob/main/schema/plant.schema.json",
  "title": "Plant",
  "description": "Single aquatic plant species entry. GENERATED from js/schema.ts (zod) by `npm run gen:schema` - do not edit by hand.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "scientificName": {
      "type": "string",
      "minLength": 3
    },
    "family": {
      "type": "string",
      "minLength": 3
    },
    "taxonomy": {
      "type": "object",
      "properties": {
        "kingdom": {
          "type": "string"
        },
        "phylum": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "order": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "genus": {
          "type": "string"
        },
        "species": {
          "type": "string"
        },
        "cultivar": {
          "type": "string"
        }
      },
      "required": [
        "kingdom",
        "phylum",
        "class",
        "order",
        "family",
        "genus",
        "species"
      ],
      "additionalProperties": false
    },
    "commonNames": {
      "type": "object",
      "properties": {
        "en": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": false
    },
    "group": {
      "type": "string",
      "enum": [
        "stem",
        "rosette",
        "carpeting",
        "epiphyte",
        "moss",
        "floating",
        "rhizome"
      ]
    },
    "growthForm": {
      "type": "string",
      "enum": [
        "stem",
        "rosette",
        "carpeting",
        "epiphyte",
        "moss",
        "floating",
        "rhizome"
      ]
    },
    "origin": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "difficultyLabel": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard",
        "expert"
      ]
    },
    "envelope": {
      "type": "object",
      "properties": {
        "light": {
          "type": "object",
          "properties": {
            "min": {
              "type": [
                "number",
                "null"
              ]
            },
            "opt": {
              "type": [
                "number",
                "null"
              ]
            },
            "max": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "type": "string"
            }
          },
          "required": [
            "min",
            "opt",
            "max",
            "unit"
          ],
          "additionalProperties": false
        },
        "co2": {
          "type": "object",
          "properties": {
            "min": {
              "type": [
                "number",
                "null"
              ]
            },
            "opt": {
              "type": [
                "number",
                "null"
              ]
            },
            "max": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "type": "string"
            }
          },
          "required": [
            "min",
            "opt",
            "max",
            "unit"
          ],
          "additionalProperties": false
        },
        "temperatureC": {
          "type": "object",
          "properties": {
            "min": {
              "type": [
                "number",
                "null"
              ]
            },
            "opt": {
              "type": [
                "number",
                "null"
              ]
            },
            "max": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "min",
            "opt",
            "max"
          ],
          "additionalProperties": false
        },
        "pH": {
          "type": "object",
          "properties": {
            "min": {
              "type": [
                "number",
                "null"
              ]
            },
            "opt": {
              "type": [
                "number",
                "null"
              ]
            },
            "max": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "min",
            "opt",
            "max"
          ],
          "additionalProperties": false
        },
        "gh": {
          "type": "object",
          "properties": {
            "min": {
              "type": [
                "number",
                "null"
              ]
            },
            "opt": {
              "type": [
                "number",
                "null"
              ]
            },
            "max": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "min",
            "opt",
            "max"
          ],
          "additionalProperties": false
        },
        "kh": {
          "type": "object",
          "properties": {
            "min": {
              "type": [
                "number",
                "null"
              ]
            },
            "opt": {
              "type": [
                "number",
                "null"
              ]
            },
            "max": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "min",
            "opt",
            "max"
          ],
          "additionalProperties": false
        },
        "tdsPpm": {
          "type": "object",
          "properties": {
            "min": {
              "type": [
                "number",
                "null"
              ]
            },
            "opt": {
              "type": [
                "number",
                "null"
              ]
            },
            "max": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "min",
            "opt",
            "max"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "light",
        "co2",
        "temperatureC",
        "pH",
        "gh",
        "kh"
      ],
      "additionalProperties": false
    },
    "nutrients": {
      "type": "object",
      "properties": {
        "macros": {
          "type": "object",
          "properties": {
            "nitrogenDemand": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "phosphorusDemand": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "potassiumDemand": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          },
          "required": [
            "nitrogenDemand",
            "phosphorusDemand",
            "potassiumDemand"
          ],
          "additionalProperties": false
        },
        "micros": {
          "type": "object",
          "properties": {
            "ironDemand": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "traceDemand": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          },
          "required": [
            "ironDemand",
            "traceDemand"
          ],
          "additionalProperties": false
        },
        "rootFeeder": {
          "type": "boolean"
        },
        "waterColumnFeeder": {
          "type": "boolean"
        }
      },
      "required": [
        "macros",
        "micros",
        "rootFeeder",
        "waterColumnFeeder"
      ],
      "additionalProperties": false
    },
    "growth": {
      "type": "object",
      "properties": {
        "rate": {
          "type": "string",
          "enum": [
            "slow",
            "medium",
            "fast"
          ]
        },
        "maxHeightCm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxSpreadCm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "internodeCm": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "propagation": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "topping",
              "side-shoots",
              "runners",
              "rhizome-division",
              "adventitious-plantlets",
              "spores",
              "fragmentation",
              "seed"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "rate",
        "maxHeightCm",
        "maxSpreadCm",
        "internodeCm",
        "propagation"
      ],
      "additionalProperties": false
    },
    "placement": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "foreground",
          "midground",
          "background",
          "attached",
          "floating"
        ]
      },
      "minItems": 1
    },
    "colorRange": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "colorHex": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "sim": {
      "type": "object",
      "properties": {
        "k_photosynthesis": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "k_light": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "k_co2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "preferred_temp_c": {
          "type": "number"
        },
        "temp_tolerance_c": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "k_photosynthesis",
        "k_light",
        "k_co2",
        "preferred_temp_c",
        "temp_tolerance_c"
      ],
      "additionalProperties": false
    },
    "visual": {
      "type": "object",
      "properties": {
        "leafShape": {
          "type": "string",
          "enum": [
            "needle",
            "linear",
            "lanceolate",
            "ovate",
            "round",
            "strap",
            "cordate",
            "moss"
          ]
        },
        "arrangement": {
          "type": "string",
          "enum": [
            "opposite",
            "whorled",
            "alternate",
            "rosette",
            "creeping",
            "mat"
          ]
        },
        "leafLengthCm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 150
        },
        "leafWidthCm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "leafDensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tipColorHex": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "leafShape",
        "arrangement",
        "leafLengthCm",
        "leafWidthCm",
        "leafDensity"
      ],
      "additionalProperties": false
    },
    "regulated": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "jurisdiction": {
            "type": "string",
            "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
          },
          "status": {
            "type": "string",
            "enum": [
              "prohibited",
              "restricted",
              "watch"
            ]
          },
          "listName": {
            "type": "string",
            "minLength": 3
          },
          "since": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          "citationKey": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "jurisdiction",
          "status",
          "listName",
          "citationKey"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string"
          },
          "license": {
            "type": "string",
            "enum": [
              "CC0-1.0",
              "CC-BY-4.0",
              "CC-BY-SA-4.0",
              "CC-BY-3.0",
              "CC-BY-SA-3.0",
              "original",
              "needs-replacement"
            ]
          },
          "credit": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "src",
          "license",
          "credit"
        ],
        "additionalProperties": false
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "scientificName",
    "family",
    "taxonomy",
    "commonNames",
    "group",
    "growthForm",
    "origin",
    "difficulty",
    "difficultyLabel",
    "envelope",
    "nutrients",
    "growth",
    "placement",
    "colorRange",
    "colorHex",
    "sim",
    "notes",
    "images",
    "citations"
  ],
  "additionalProperties": false
}
