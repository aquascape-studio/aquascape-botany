{
  "name": "@aquascape-studio/botany",
  "version": "0.8.1",
  "packageManager": "pnpm@9.12.0",
  "description": "Aquascape-studio plant data + zod schema (consumer library)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plants.json": "./dist/plants.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup index.ts --format esm --dts && cp ../data/plants.json dist/plants.json",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "gen:schema": "tsx scripts/gen-json-schema.ts",
    "validate": "tsx scripts/validate.ts"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsup": "^8.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
